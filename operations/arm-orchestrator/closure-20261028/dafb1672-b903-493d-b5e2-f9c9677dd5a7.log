function moveMonth(step){let p=(calendarMonth||today().slice(0,7)).split('-').map(Number),d=new Date(p[0],p[1]-1+step,1);calendarMonth=d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0');selectedDay='';render()}
function selectDay(date){selectedDay=date;render()}
function updateSession(){if(role!=='trainer')return;let session=current().sessions.find(x=>x.date===selectedDay);if(!session||completed(current(),session))return alert('No se puede editar una sesión completada');let title=document.getElementById('session-title').value.trim();if(!title)return alert('Ingresá el nombre de la sesión');session.title=title;session.exercises=structuredClone(assigned()?.exercises||state.exercises);save();render()}
function addSession(){if(role!=='trainer')return;let input=document.getElementById('new-session-date');if(!input||!/^\d{4}-\d{2}-\d{2}$/.test(input.value))return alert('Elegí una fecha válida');let date=input.value;if(current().sessions.some(x=>x.date===date))return alert('Ya hay una sesión programada para esa fecha');current().sessions.push({date,done:false,title:'Entrenamiento',exercises:assigned()?structuredClone(assigned().exercises):structuredClone(state.exercises)});calendarMonth=date.slice(0,7);selectedDay=date;save();render()}
function removeSession(){if(role!=='trainer'||!selectedDay)return;let a=current(),i=a.sessions.findIndex(x=>x.date===selectedDay);if(i<0)return;if(completed(a,a.sessions[i]))return alert('No se puede eliminar una sesión completada');if(!confirm('¿Eliminar la sesión del '+selectedDay+'?'))return;a.sessions.splice(i,1);save();render()}
function moveSession(){if(role!=='trainer'||!selectedDay)return;let input=document.getElementById('move-session-date');if(!input||!input.value)return;let a=current(),s=a.sessions.find(x=>x.date===selectedDay);if(!s||completed(a,s))return alert('No se puede modificar una sesión completada');if(a.sessions.some(x=>x.date===input.value))return alert('Ya existe una sesión en esa fecha');s.date=input.value;selectedDay=input.value;calendarMonth=input.value.slice(0,7);save();render()}
function calendarView(){const a=current(),first=a.sessions.length?a.sessions[0].date.slice(0,7):today().slice(0,7),month=calendarMonth||first,p=month.split('-').map(Number),start=new Date(p[0],p[1]-1,1),days=new Date(p[0],p[1],0).getDate(),offset=(start.getDay()+6)%7;let cells=Array.from({length:offset},()=>'<span></span>').join('');for(let d=1;d<=days;d++){let date=month+'-'+String(d).padStart(2,'0'),session=a.sessions.find(x=>x.date===date),status=session?sessionStatus(a,session):'',color=status==='Completada'?'#c2ff49':status==='Vencida'?'#ff8a80':status==='Hoy'?'#8bc7ff':status==='Programada'?'#e1df93':'transparent';cells+='<button aria-label="'+esc(date+(status?' '+status:''))+'" aria-pressed="'+(selectedDay===date)+'" onclick="selectDay(\''+date+'\')" style="min-width:0;min-height:53px;padding:5px 2px;text-align:center;border:1px solid '+(selectedDay===date?'#c2ff49':'#45555d')+';background:#22323a"><b>'+d+'</b><span style="display:block;width:7px;height:7px;margin:5px auto 0;border-radius:50%;background:'+color+'"></span></button>'}let day=selectedDay||today(),session=a.sessions.find(x=>x.date===day),logs=state.logs.filter(l=>l.athleteId===a.id&&(l.sessionDate===day||(!l.sessionDate&&l.date===day))),details='<div class="card"><h3>'+esc(day)+'</h3><p>Estado: '+(session?sessionStatus(a,session):'Sin sesión programada')+'</p>'+(session?'<p><b>'+esc(session.title||'Entrenamiento')+'</b></p><p>Ejercicios:</p>'+(session.exercises||assigned()?.exercises||[]).map(e=>'<p>'+esc(e.name)+' · '+e.sets.length+' series</p>').join(''):'')+(logs.length?'<h4>Resultados registrados</h4>'+logs.map(l=>'<p>RPE '+l.rpe+' · '+l.duration+' min · Volumen '+volume(l.exercises)+' kg-reps</p>').join(''):'<p class="muted">Sin resultados registrados para este día.</p>')+'</div>';let controls=role==='trainer'?'<div class="card"><details><summary>+ Programar sesión</summary><label>Fecha<input id="new-session-date" type="date" value="'+(selectedDay||today())+'"></label><button class="primary" onclick="addSession()">+ Programar</button></details>'+(session&&!completed(a,session)?'<details><summary>Editar sesión seleccionada</summary><label>Nombre de sesión<input id="session-title" value="'+esc(session.title||'Entrenamiento')+'"></label><button onclick="updateSession()">Guardar nombre y rutina actual</button><h3>Cambiar fecha</h3><label>Nueva fecha<input id="move-session-date" type="date" value="'+day+'"></label><div class="row"><button onclick="moveSession()">Cambiar fecha</button><button onclick="removeSession()">Eliminar sesión</button></div></details>':'')+'</div>':'';return '<h2>Calendario de entrenamientos</h2>'+(role==='trainer'?'<label>Alumno<select onchange="choose(this.value)">'+state.athletes.map(x=>'<option value="'+x.id+'" '+(x.id===athlete?'selected':'')+'>'+esc(x.name)+'</option>').join('')+'</select></label>':'<p>Alumno: '+esc(a.name)+'</p>')+'<div class="card"><div class="row"><button onclick="moveMonth(-1)">‹</button><b>'+start.toLocaleDateString('es-AR',{month:'long',year:'numeric'})+'</b><button onclick="moveMonth(1)">›</button></div><div style="display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:3px;margin-top:14px">'+['L','M','M','J','V','S','D'].map(x=>'<b style="text-align:center">'+x+'</b>').join('')+cells+'</div></div><p class="muted">Puntos: verde completada · rojo vencida · azul hoy · amarillo programada. Tocá una fecha para ver detalles.</p>'+details+controls}
function render(){nav();const root=document.getElementById('screen');if(!role){root.innerHTML='<h2>Elegí un perfil para probar</h2><p>Ambos perfiles usan datos ficticios locales. No existe autenticación ni separación de permisos del servidor en esta demo.</p><div class="grid"><div class="card"><h3>Entrenador</h3><p>Administrá alumnos, rutinas, adherencia y notas.</p><button class="primary" onclick="enterRole(\'trainer\')">Entrar como entrenador</button></div><div class="card"><h3>Alumno</h3><p>Consultá tu sesión, registrá esfuerzo y revisá tu historial.</p><button class="primary" onclick="enterRole(\'student\')">Entrar como alumno</button></div></div>';return}if(page==='calendar'){root.innerHTML=calendarView()}else if(page==='stats'){root.innerHTML=stats()}else if(page==='dashboard'){root.innerHTML='<h2>Panel del entrenador</h2><div class="grid"><div class="card"><small>Alumnos</small><div class="metric">'+state.athletes.length+'</div></div><div class="card"><small>Sesiones registradas en demo</small><div class="metric">'+state.logs.length+'</div></div><div class="card"><small>Adherencia media</small><div class="metric">'+Math.round(state.athletes.reduce((n,a)=>n+adherence(a),0)/state.athletes.length)+'%</div></div></div><h3>Seguimiento</h3>'+state.athletes.map(a=>'<div class="card row"><div><b>'+esc(a.name)+'</b><p>'+esc(a.goal)+' · Adherencia '+adherence(a)+'%</p><progress max="100" value="'+adherence(a)+'"></progress></div><button onclick="choose('+a.id+');go(\'athletes\')">Abrir ficha</button></div>').join('')}else if(page==='athletes'){root.innerHTML='<h2>Ficha del alumno</h2><select onchange="choose(this.value)">'+state.athletes.map(a=>'<option value="'+a.id+'" '+(a.id===athlete?'selected':'')+'>'+esc(a.name)+'</option>').join('')+'</select><div class="card"><h3>'+esc(current().name)+'</h3><p>Objetivo: '+esc(current().goal)+'</p><div class="metric">'+adherence(current())+'% adherencia</div><p>Calculada solo sobre sesiones con fecha vencida o actual.</p></div><h3>Calendario de sesiones</h3>'+current().sessions.slice().sort((a,b)=>a.date.localeCompare(b.date)).map(s=>'<div class="card row"><span>'+esc(s.date)+'</span><span class="pill">'+sessionStatus(current(),s)+'</span></div>').join('')+'<h3>Rutina del alumno</h3><div class="card"><p>'+(assigned()?'Rutina asignada · '+assigned().exercises.length+' ejercicios':'Sin rutina asignada')+'</p><button class="primary" onclick="assign()">Asignar copia de rutina</button></div><h3>Notas del entrenador</h3><textarea id="note" rows="3" style="width:100%" placeholder="Observación privada de demostración"></textarea><button class="primary" onclick="addNote()">Guardar nota</button>'+state.notes.filter(n=>n.athlete===athlete).map(n=>'<div class="card">'+esc(n.text)+'</div>').join('')}else if(page==='plan'){root.innerHTML='<h2>Editor de sesión</h2><p>Series, repeticiones, carga y RIR. Los cambios de esta demo se guardan solo en este navegador.</p><div class="card" id="assign-card"><h3>Asignar rutina a un alumno</h3><label>Elegí alumno<select onchange="choose(this.value)">'+state.athletes.map(a=>'<option value="'+a.id+'" '+(a.id===athlete?'selected':'')+'>'+esc(a.name)+'</option>').join('')+'</select></label><p>'+(assigned()?'Ya tiene rutina asignada ('+assigned().exercises.length+' ejercicios)':'Todavía no tiene rutina asignada')+'</p><button class="primary" onclick="assign()">Asignar esta rutina</button></div>'+state.exercises.map((e,i)=>'<div class="card" id="exercise-card-'+i+'"><h3>'+esc(e.name)+'</h3><label>Enlace de video demostrativo (HTTPS)<input id="video-url-'+i+'" type="url" inputmode="url" placeholder="https://..." value="'+esc(e.videoUrl||'')+'"></label><div class="row"><button onclick="saveVideo('+i+',false)">Guardar video</button><button class="primary" onclick="saveVideo('+i+',true)">Guardar y '+(i===state.exercises.length-1?'finalizar':'siguiente ejercicio')+' →</button></div><p class="muted">Guardá el enlace y avanzá al siguiente ejercicio. Al terminar, asigná nuevamente la rutina al alumno para que reciba los videos.</p>'+videoBlock(e)+e.sets.map((s,j)=>'<div class="series-entry"><div class="row"><b>Serie '+(j+1)+'</b><button type="button" onclick="removeSet('+i+','+j+')" '+(e.sets.length===1?'disabled':'')+' aria-label="Eliminar serie '+(j+1)+'">Eliminar serie</button></div><div class="sets"><label>Reps<input type="number" min="0" value="'+s.reps+'" onchange="setField('+i+','+j+',\'reps\',this.value)"></label><label>Kg<input type="number" min="0" step=".5" value="'+s.kg+'" onchange="setField('+i+','+j+',\'kg\',this.value)"></label><label>RIR<input type="number" min="0" max="10" value="'+s.rir+'" onchange="setField('+i+','+j+',\'rir\',this.value)"></label></div></div>').join('')+'<button onclick="addSet('+i+')">+ Serie</button></div>').join('')}else if(page==='student'){root.innerHTML='<h2>Entrenamiento del alumno</h2><label>Alumno de prueba<select onchange="choose(this.value)">'+state.athletes.map(a=>'<option value="'+a.id+'" '+(a.id===athlete?'selected':'')+'>'+esc(a.name)+'</option>').join('')+'</select></label><div class="notice">Vista de demostración: los registros no se envían a ningún servidor.</div><p>Alumno: '+esc(current().name)+'</p>'+(current().sessions.length?'<label>Sesión programada<select onchange="chooseWorkout(this.value)"><option value="">Rutina general</option>'+current().sessions.filter(x=>!completed(current(),x)).sort((a,b)=>a.date.localeCompare(b.date)).map(x=>'<option value="'+x.date+'" '+(workoutDate===x.date?'selected':'')+'>'+esc(x.date)+' · '+esc(x.title||'Entrenamiento')+'</option>').join('')+'</select></label>':'')+(trainingDraft().length?trainingDraft().map((e,i)=>'<div class="card"><h3>'+esc(e.name)+'</h3>'+videoBlock(e)+'<p class="muted">Cargá los valores efectivamente realizados</p>'+e.sets.map((set,j)=>'<div class="sets"><label>Reps<input aria-label="Repeticiones serie '+(j+1)+'" type="number" min="0" value="'+set.reps+'" onchange="setActual('+i+','+j+',\'reps\',this.value)"></label><label>Kg<input aria-label="Carga serie '+(j+1)+'" type="number" min="0" step=".5" value="'+set.kg+'" onchange="setActual('+i+','+j+',\'kg\',this.value)"></label><label>RIR<input aria-label="RIR serie '+(j+1)+'" type="number" min="0" max="10" value="'+set.rir+'" onchange="setActual('+i+','+j+',\'rir\',this.value)"></label></div>').join('')+'</div>').join(''):'<div class="card"><p>No hay rutina asignada. Entrá como entrenador para asignarla.</p></div>')+'<label>RPE percibido (1–10)<input id="rpe" type="number" min="1" max="10" value="7"></label><label>Duración (min)<input id="duration" type="number" min="1" value="45"></label><label>Sensaciones<textarea id="feeling" rows="3" style="width:100%"></textarea></label><button class="primary" onclick="complete()">Completar sesión demo</button>'}else{root.innerHTML='<h2>Historial de sesiones</h2>'+(!(role==='trainer'?state.logs:state.logs.filter(l=>Number(l.athleteId)===Number(athlete))).length?'<p>Todavía no hay registros de sesiones en esta demo.</p>':state.logs.filter(l=>role==='trainer'||Number(l.athleteId)===Number(athlete)).slice().reverse().map(l=>'<div class="card"><b>'+esc(l.name)+'</b><p>'+esc(l.date)+' · '+l.duration+' min · RPE '+l.rpe+'</p><p>'+esc(l.feeling)+'</p><details><summary>Series registradas</summary>'+l.exercises.map(e=>'<p>'+esc(e.name)+': '+e.sets.map(s=>s.reps+'×'+s.kg+'kg (RIR '+s.rir+')').join(' · ')+'</p>').join('')+'</details></div>').join(''))}if(role==='trainer')root.innerHTML+='<button onclick="switchRole()">Cambiar perfil</button>';root.innerHTML+='<div class="card"><h3>Datos de esta versión</h3><p>Sesiones guardadas: '+state.logs.length+'. Cada dirección de Vercel usa su propio almacenamiento local.</p><button onclick="exportData()">Exportar respaldo</button> <label>Importar respaldo<input type="file" accept="application/json" onchange="importData(this)" /></label></div><p class="muted"><small>Prototipo aislado: no representa el estado del backend Supabase descrito en el documento maestro.</small></p>'}
function setField(i,j,k,v){state.exercises[i].sets[j][k]=Number(v);save()}
function addSet(i){let e=state.exercises[i],last=e.sets.at(-1)||{reps:10,kg:0,rir:2};e.sets.push({...last});save();render();document.getElementById('exercise-card-'+i)?.scrollIntoView({block:'start'})}
function removeSet(i,j){let e=state.exercises[i];if(e.sets.length<=1)return alert('Cada ejercicio necesita al menos una serie.');e.sets.splice(j,1);save();render();document.getElementById('exercise-card-'+i)?.scrollIntoView({block:'start'})}
function addNote(){let v=document.getElementById('note').value.trim();if(!v)return;state.notes.push({athlete,text:v});save();render()}
function complete(){if(!trainingDraft().length)return alert('No hay rutina asignada');let r=Number(document.getElementById('rpe').value),d=Number(document.getElementById('duration').value);if(r<1||r>10||d<=0||!Number.isFinite(r)||!Number.isFinite(d))return alert('Revisá el RPE y la duración');const next=workoutDate?current().sessions.find(x=>x.date===workoutDate):current().sessions.filter(x=>!completed(current(),x)&&x.date<=today()).sort((a,b)=>a.date.localeCompare(b.date))[0];if(next&&completed(current(),next))return alert('Esta sesión ya está completada. Elegí otra fecha.');if(trainingDraft().some(e=>e.sets.some(x=>!Number.isFinite(Number(x.reps))||Number(x.reps)<0||!Number.isFinite(Number(x.kg))||Number(x.kg)<0||!Number.isFinite(Number(x.rir))||Number(x.rir)<0||Number(x.rir)>10)))return alert('Revisá las repeticiones, cargas y RIR.');state.logs.push({athleteId:athlete,assignmentId:assigned()?.id||null,sessionDate:next?next.date:null,name:current().name,date:today(),rpe:r,duration:d,feeling:document.getElementById('feeling').value,exercises:structuredClone(trainingDraft())});draft=[];workoutDate='';save();go('history');alert('Sesión registrada. Podés verla en Mi historial y en Progreso del entrenador.')}render();

