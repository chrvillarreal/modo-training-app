function save(){localStorage.setItem('mt_students',JSON.stringify(S));localStorage.setItem('mt_routine',JSON.stringify(R))}
function toast(t){let x=document.createElement('div');x.className='toast';x.textContent=t;document.body.appendChild(x);setTimeout(()=>x.remove(),1800)}
function enter(){landing.style.display='none';app.style.display='grid';app.classList.add('active');show('home')}
function show(p){title.textContent=P.find(x=>x[0]===p)[1];document.querySelectorAll('.nav button').forEach((b,i)=>b.classList.toggle('on',P[i][0]===p));view.innerHTML=({home,students,routines,library,calendar,progress}[p])()}
function home(){let avg=Math.round(S.reduce((a,s)=>a+s.adh,0)/S.length);return `<div class="grid kpis"><div class="card kpi"><small>Alumnos activos</small><b>${S.length}</b></div><div class="card kpi"><small>Adherencia media</small><b>${avg}%</b></div><div class="card kpi"><small>Sesiones semana</small><b>11/15</b></div><div class="card kpi"><small>Para revisar</small><b>${S.filter(s=>s.adh<70).length}</b></div></div><h2>Seguimiento</h2><div class="grid two"><div class="card">${S.map(s=>`<div class="student"><div><b>${s.name}</b><small>${s.goal}</small></div><b>${s.adh}%</b><button onclick="openStudent(${s.id})">Ver</button></div>`).join('')}</div><div class="card dark"><span class="eyebrow">SEÑALES PARA REVISAR</span><h2>Menos dashboard.<br>Más decisiones.</h2><p>${S.filter(s=>s.adh<70).map(s=>s.name+' está en '+s.adh+'% de adherencia.').join(' ')}</p><button class="primary" onclick="show('progress')">Revisar progreso</button></div></div><h2>Accesos rápidos</h2><div class="grid three quick"><button onclick="show('routines')">⧉<b>Duplicar rutina</b><span class="muted">Reutilizá una base.</span></button><button onclick="newStudent()">＋<b>Nuevo alumno</b><span class="muted">Ficha y seguimiento.</span></button><button onclick="show('calendar')">▦<b>Ver semana</b><span class="muted">Sesiones y adherencia.</span></button></div>`}
function students(){return `<div class="toolbar"><input class="search" placeholder="Buscar alumno…" oninput="filterStudents(this.value)"><button class="primary" onclick="newStudent()">+ Nuevo alumno</button></div><div id="studentGrid" class="grid three">${studentCards(S)}</div>`}
function studentCards(a){return a.map(s=>`<div class="card"><span class="${s.adh<70?'pill warn':'pill'}">${s.adh<70?'REVISAR':'ACTIVA'}</span><h3>${s.name}</h3><p>${s.goal}</p><b>Adherencia ${s.adh}%</b><div class="bar"><i style="width:${s.adh}%"></i></div><p><button onclick="openStudent(${s.id})">Abrir ficha</button></p></div>`).join('')}
function filterStudents(q){studentGrid.innerHTML=studentCards(S.filter(s=>(s.name+s.goal).toLowerCase().includes(q.toLowerCase())))}
function newStudent(){title.textContent='Nuevo alumno';view.innerHTML=`<div class="card"><span class="eyebrow" style="color:#587900">ALTA DE ALUMNO</span><h2>Ficha inicial</h2><div class="formgrid"><label>Nombre<input id="nname" class="field" placeholder="Nombre y apellido"></label><label>Email<input id="nemail" class="field" type="email"></label><label>Edad<input id="nage" class="field" type="number"></label><label>Objetivo<select id="ngoal" class="field"><option>Fuerza general</option><option>Hipertrofia</option><option>Rendimiento</option><option>Recomposición</option></select></label></div><p><label><b>Notas / anamnesis inicial</b><textarea id="nnotes" class="field" rows="5" placeholder="Antecedentes, limitaciones, preferencias…"></textarea></label></p><button class="primary" onclick="createStudent()">Crear alumno</button> <button onclick="show('students')">Cancelar</button></div>`}
function createStudent(){if(!nname.value.trim())return toast('Ingresá un nombre');let s={id:Date.now(),name:nname.value.trim(),email:nemail.value,age:nage.value,goal:ngoal.value,notes:nnotes.value,adh:0,last:'Sin sesiones'};S.push(s);save();selected=s.id;toast('Alumno creado');openStudent(s.id)}
function openStudent(id){selected=id;let s=S.find(x=>x.id===id);title.textContent='Ficha de alumno';view.innerHTML=`<div class="profileHead"><div class="avatar">${s.name.split(' ').map(x=>x[0]).slice(0,2).join('')}</div><div><span class="pill">ACTIVO</span><h2 style="margin:5px 0">${s.name}</h2><span class="muted">${s.goal} · ${s.age||'—'} años</span></div></div><div class="tabs"><button class="active">Resumen</button><button onclick="show('routines')">Rutina</button><button onclick="studentHistory(${id})">Sesiones</button><button onclick="show('progress')">Progreso</button></div><div class="grid two"><div class="card"><h3>Objetivo</h3><p>${s.goal}</p><h3>Anamnesis / notas privadas</h3><div class="note">${s.notes||'Sin notas todavía.'}</div><button onclick="editStudent(${id})">Editar ficha</button></div><div class="card"><h3>Estado</h3><p>Adherencia <b class="right">${s.adh}%</b></p><div class="bar"><i style="width:${s.adh}%"></i></div><p>Última sesión <b class="right">${s.last}</b></p><button class="primary" onclick="show('routines')">Ver rutina activa</button></div></div>`}
function editStudent(id){let s=S.find(x=>x.id===id);view.innerHTML=`<div class="card"><h2>Editar ${s.name}</h2><div class="formgrid"><label>Nombre<input id="ename" class="field" value="${s.name}"></label><label>Email<input id="eemail" class="field" value="${s.email||''}"></label><label>Edad<input id="eage" class="field" type="number" value="${s.age||''}"></label><label>Objetivo<input id="egoal" class="field" value="${s.goal}"></label></div><p><textarea id="enotes" class="field" rows="5">${s.notes||''}</textarea></p><button class="primary" onclick="updateStudent(${id})">Guardar cambios</button> <button onclick="openStudent(${id})">Cancelar</button></div>`}
function updateStudent(id){let s=S.find(x=>x.id===id);Object.assign(s,{name:ename.value,email:eemail.value,age:eage.value,goal:egoal.value,notes:enotes.value});save();toast('Ficha actualizada');openStudent(id)}
function studentHistory(id){let s=S.find(x=>x.id===id);title.textContent='Sesiones';view.innerHTML=`<div class="card"><h2>${s.name} · Historial</h2><div class="student"><b>Fuerza A</b><span>Completada</span><span class="pill">RPE 8</span></div><div class="student"><b>Fuerza B</b><span>Completada</span><span class="pill">RPE 7</span></div><div class="student"><b>Fuerza A</b><span>Completada</span><span class="pill">RPE 9</span></div><p class="muted">Demo local. En V2 cada sesión quedará persistida en base de datos con snapshot del plan ejecutado.</p></div>`}
function routines(){let s=S.find(x=>x.id===selected)||S[0];return `<div class="toolbar"><div><h2 style="margin:0">Rutina activa · ${s.name}</h2><p class="muted">Crear → duplicar → personalizar → asignar.</p></div><div><button onclick="duplicateRoutine()">Duplicar</button> <button class="primary" onclick="saveRoutine()">Guardar</button></div></div><div class="routine"><div class="rhead"><span class="pill">ACTIVA</span><h2>Fuerza general</h2><p>Día A · Tren inferior + empuje</p></div><div id="exerciseRows">${routineRows()}</div><div style="padding:14px"><button onclick="addExercise()">+ Agregar ejercicio</button></div></div>`}
function routineRows(){return R.map((e,i)=>`<div class="exercise"><b>${e.name}</b><input value="${e.sets}" onchange="R[${i}].sets=this.value"><input value="${e.reps}" onchange="R[${i}].reps=this.value"><input value="RIR ${e.rir}" onchange="R[${i}].rir=this.value.replace(/[^0-9]/g,'')"><input value="${e.rest}s" onchange="R[${i}].rest=this.value.replace(/[^0-9]/g,'')"><button onclick="removeExercise(${i})">×</button></div>`).join('')}
function addExercise(){R.push({name:E[R.length%E.length],sets:3,reps:10,rir:2,rest:90});show('routines')}
function removeExercise(i){R.splice(i,1);show('routines')}
function duplicateRoutine(){R=R.map(x=>({...x}));toast('Rutina duplicada para personalizar')}
function saveRoutine(){save();toast('Rutina guardada en este dispositivo')}
function library(){return `<input class="search" placeholder="Buscar ejercicio, patrón o grupo muscular…" oninput="filterLib(this.value)"><div id="lib" class="grid three">${libCards(E)}</div>`}
function libCards(a){return a.map((e,i)=>`<div class="card"><span class="pill">${['SENTADILLA','BISAGRA','EMPUJE','TRACCIÓN'][i%4]}</span><h3>${e}</h3><p>Video técnico · variantes · notas.</p><button onclick="toast('Vista técnica: ${e}')">Ver ejercicio</button></div>`).join('')}
function filterLib(q){lib.innerHTML=libCards(E.filter(e=>e.toLowerCase().includes(q.toLowerCase())))}
function calendar(){return `<div class="grid two"><div class="card"><h2>Semana actual</h2>${['Lun · Lucía · Fuerza A','Mar · Sofía · Potencia','Mié · Martín · Hipertrofia','Jue · Lucía · Fuerza B','Vie · Nicolás · Full body'].map((x,i)=>`<div class="student"><b>${x}</b><span class="pill">${i<3?'COMPLETADA':'PENDIENTE'}</span></div>`).join('')}</div><div class="card"><h2>Adherencia</h2>${S.map(s=>`<p><b>${s.name}</b><b class="right">${s.adh}%</b></p><div class="bar"><i style="width:${s.adh}%"></i></div>`).join('')}</div></div>`}
function progress(){let s=S.find(x=>x.id===selected)||S[0];return `<div class="grid two"><div class="card"><span class="eyebrow" style="color:#587900">EVOLUCIÓN DE CARGA</span><h2>Sentadilla · ${s.name}</h2><div class="chart">${[45,52,58,64,70,76,82,90].map(v=>`<i style="height:${v}%"></i>`).join('')}</div></div><div class="card"><h2>Resumen</h2><p>Carga estimada <b class="right">+12%</b></p><p>Volumen semanal <b class="right">4.860 kg</b></p><p>Adherencia <b class="right">${s.adh}%</b></p><p>Última sensación <b class="right">RPE alto</b></p></div></div>`}
