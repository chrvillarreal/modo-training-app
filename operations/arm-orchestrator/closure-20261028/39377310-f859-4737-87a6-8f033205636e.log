const {chromium}=require(process.env.PLAYWRIGHT_MODULE || '/opt/codex/runtimes/codex-primary-runtime/dependencies/node/node_modules/playwright');
const assert=require('node:assert/strict');
(async()=>{const b=await chromium.launch({headless:true,executablePath:process.env.CHROME_PATH||'/tmp/arm-chromium',args:['--no-sandbox','--disable-dev-shm-usage']});const c=await b.newContext();await c.route('**/*',r=>new URL(r.request().url()).hostname==='127.0.0.1'?r.continue():r.abort());const p=await c.newPage();const results=[];
await p.goto('http://127.0.0.1:4179/rutina-agustin.html');const controls=await p.locator('input,textarea,select').count();assert.equal(controls,0);results.push({id:'MODO-01',confirmed:true,detail:'Agustin: zero editable controls; 4 static training days',controls,days:await p.locator('.training-day').count()});
await p.goto('http://127.0.0.1:4179/index.html');await p.evaluate(()=>{enter();selected=1;R[0].sets=9;saveRoutine();selected=2;show('routines')});const sets=await p.locator('.exercise input').first().inputValue();assert.equal(sets,'9');results.push({id:'MODO-02',confirmed:true,detail:'Changing student 1 sets to 9 also changes student 2',sets});
await p.evaluate(()=>{newStudent();nname.value='<img src=x onerror="window.armXss=1">';createStudent()});await p.waitForFunction(()=>window.armXss===1);results.push({id:'MODO-03',confirmed:true,detail:'Student name HTML executes harmless local marker via innerHTML'});
const errors=[];p.on('pageerror',e=>errors.push(e.message));await p.evaluate(()=>localStorage.setItem('mt_students','broken-json'));await p.reload();assert(errors.some(e=>/JSON|Unexpected token/.test(e)));results.push({id:'MODO-04',confirmed:true,detail:'Malformed mt_students throws during initialization',errors});
await c.clearCookies();await p.evaluate(()=>localStorage.clear());await p.reload();await p.evaluate(()=>enter());for(const w of [320,390,1440]){await p.setViewportSize({width:w,height:900});results.push({id:'MODO-layout-'+w,overflow:await p.evaluate(()=>document.documentElement.scrollWidth>innerWidth)});}
console.log(JSON.stringify(results,null,2));await b.close();})().catch(e=>{console.error(e);process.exitCode=1});

