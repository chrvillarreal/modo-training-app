tests/study.test.cjs
const test=require('node:test'),assert=require('node:assert/strict'),vm=require('node:vm'),fs=require('node:fs'),path=require('node:path');
const root=path.join(__dirname,'..');
function engine(blocked=false){const data=new Map([['arm-done-01','1']]);const c={localStorage:{getItem:k=>{if(blocked)throw Error();return data.get(k)||null;},setItem:(k,v)=>{if(blocked)throw Error();data.set(k,v);}},Date};vm.runInNewContext(fs.readFileSync(path.join(root,'study-core.js'),'utf8'),c);return {api:c.RMStudy,data};}
test('exam subtracts mistakes and counts omissions without clamping negative points',()=>{const {api}=engine();assert.equal(api.score([...Array(24).fill(true),...Array(16).fill(false)]).percent,20);assert.equal(api.score([true,false,null],40).blank,38);assert.equal(api.score(Array(40).fill(false)).points,-40);});
test('immediate repeated answers never become delayed retention',()=>{const {api,data}=engine();const t=100000;api.answer('11','practice-0',1,true,'practice',t);api.answer('11','review-0',0,true,'review',t+1000);assert.equal(api.status('11',t+2000).retention,false);api.answer('11','review-0',0,true,'review',t+api.DAY);assert.equal(api.status('11',t+api.DAY).retention,true);assert.equal(data.get('arm-done-01'),'1');});
test('backup merges attempts without replacing existing notes or other records',()=>{const {api}=engine();api.saveNote('11','original');api.answer('11','practice-0',1,true);const backup=api.read();backup.notes['11']='imported';api.importBackup(JSON.stringify(backup));assert.equal(api.read().notes['11'],'original');assert.equal(api.lesson('11').attempts.length,1);assert.throws(()=>api.importBackup('{"version":2}'));});
test('storage unavailable preserves current-session work and reports failure',()=>{const {api}=engine(true);api.saveNote('11','draft');assert.equal(api.read().notes['11'],'draft');assert.equal(api.storageAvailable(),false);});
test('successful delayed review schedules a later review without repeated-click inflation',()=>{const {api}=engine();const t=100000;api.answer('11','practice-0',1,true,'practice',t);api.answer('11','review-0',0,true,'review',t+api.DAY);api.answer('11','review-0',0,true,'review',t+api.DAY+1);assert.equal(api.status('11',t+2*api.DAY).due,false);assert.equal(api.status('11',t+4*api.DAY).due,true);});
test('all source scripts parse and static local destinations exist',()=>{for(const file of fs.readdirSync(root)){if(!/\.(html|js)$/.test(file))continue;const s=fs.readFileSync(path.join(root,file),'utf8');if(file.endsWith('.js'))new vm.Script(s,{filename:file});else for(const m of s.matchAll(/<script\b[^>]*>([\s\S]*?)<\/script>/gi))new vm.Script(m[1],{filename:file});if(file.endsWith('.html'))for(const m of s.matchAll(/(?:href|src)=["']([\w-]+\.(?:js|css|html))(?:[?#][^"']*)?["']/g))assert(fs.existsSync(path.join(root,m[1])),file+' → '+m[1]);}});
test('eleven guides have valid exercise keys and a distinct retrieval question',()=>{const c={window:{}};vm.runInNewContext(fs.readFileSync(path.join(root,'study-lessons.js'),'utf8'),c);const lessons=c.window.STUDY_LESSONS;assert.equal(Object.keys(lessons).length,11);for(const d of Object.values(lessons)){assert(d.explanation.length>=2);for(const q of [...d.q,d.review])assert(q[1][q[2]]);assert(!d.q.some(q=>q[0]===d.review[0]));}});

tests/server.cjs
const http=require('node:http'),fs=require('node:fs'),path=require('node:path');const root=path.resolve(__dirname,'..');http.createServer((req,res)=>{let file;try{file=path.resolve(root,'.'+decodeURIComponent(new URL(req.url,'http://localhost').pathname));}catch{res.writeHead(400);return res.end();}if(!file.startsWith(root+path.sep)){res.writeHead(403);return res.end();}if(!fs.existsSync(file)||!fs.statSync(file).isFile()){res.writeHead(404);return res.end();}res.setHeader('Content-Type',({'.html':'text/html; charset=utf-8','.js':'text/javascript; charset=utf-8','.css':'text/css; charset=utf-8'})[path.extname(file)]||'application/octet-stream');fs.createReadStream(file).pipe(res);}).listen(4178,'127.0.0.1',()=>console.log('Preview: http://127.0.0.1:4178/curso-arm.html'));

tests/preservation.cjs
const fs=require('node:fs'),vm=require('node:vm'),assert=require('node:assert/strict'),cp=require('node:child_process');
const original=cp.execFileSync('git',['show','67ed8770367c17e3b62295dae68c60ba5daebdda:curso-arm.html'],{encoding:'utf8'}),current=fs.readFileSync('curso-arm.html','utf8');
const inv=s=>vm.runInNewContext(s.match(/const INVENTORY\s*=\s*(\[[\s\S]*?\]);/)[0]+';JSON.stringify(INVENTORY)');assert.equal(inv(original),inv(current));
const books=s=>[...s.matchAll(/https:\/\/[^"'<> ]+\/bibliografia-complementaria\/[^"'<> ]+/g)].map(x=>x[0]).sort();assert.deepEqual(books(original),books(current));console.log('199 inventory routes and supplementary book URLs preserved.');

